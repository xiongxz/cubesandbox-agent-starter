PORT=49999
MEMORY_DIR=/app/memories
ENVD_PORT=49983

AGENT_TENANT_ID=t1
AGENT_USER_ID=u1
AGENT_AGENT_ID=default-agent
AGENT_SESSION_ID=boot-session

LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SEC=60
LLM_SYSTEM_PROMPT=You are a helpful assistant running inside a CubeSandbox agent runtime.
EXEC_TIMEOUT_SEC=15
EXEC_MAX_OUTPUT_CHARS=12000
EXEC_WORKDIR=/tmp/agent-workspace
